          "children": [
            {
              "type": "text",
              "id": "6NR32",
              "name": "c3bt",
              "fill": "#4CAF50",
              "content": "🎨 宋代",
              "fontFamily": "Inter",
              "fontSize": 44,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "AbFA3",
              "name": "c3bd",
              "fill": "#333333",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "清明节达到鼎盛。张择端《清明上河图》描绘了北宋汴京清明时节的繁华景象。扫墓、踏青、插柳、放风筝成为固定习俗。",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
              "fontSize": 46,
              "fontWeight": "normal"
            }
          ]
        },
