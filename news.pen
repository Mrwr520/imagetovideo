                18
              ],
              "children": [
                {
                  "type": "text",
                  "id": "yplgh",
                  "name": "sbt3",
                  "fill": "#334155",
                  "textGrowth": "fixed-width",
                  "width": 908,
                  "content": "美联储维持利率不变，将2026年PCE通胀预期从2.4%上调至2.7%。受伊朗战争推高油价影响，债券市场已完全抹去2026年降息预期。CME FedWatch显示年底前降息概率仅17%，部分交易员开始押注加息。10年期国债收益率升破4.4%。",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 26,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "hrBul",
              "name": "box3",
              "fill": "#EFF6FF",
              "cornerRadius": 6,
