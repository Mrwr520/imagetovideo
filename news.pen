                {
                  "type": "text",
                  "id": "T3yYo",
                  "name": "sbt1",
                  "fill": "#334155",
                  "textGrowth": "fixed-width",
                  "width": 908,
                  "content": "3月30日，特朗普在社交媒体表示美国正与伊朗新政权进行\"认真讨论\"以结束军事行动，市场瞬间反弹。道指涨406点，标普500涨0.5%，纳斯达克涨0.3%。但伊朗随后否认谈判进展，涨幅回吐过半。",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 26,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "vjRwY",
              "name": "box1",
              "fill": "#EFF6FF",
