              "children": [
                {
                  "type": "text",
                  "id": "k1W26",
                  "name": "sbt2",
                  "fill": "#334155",
                  "textGrowth": "fixed-width",
                  "width": 908,
                  "content": "布伦特原油3月触及$119.50/桶，为2022年6月以来最高。伊朗几乎关闭霍尔木兹海峡，全球20%石油供应受阻。IEA称这是\"全球石油市场历史上最大的供应中断\"。油气CEO们在CERAWeek会议上警告：市场低估了中断的严重性。",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 26,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "tbpuw",
              "name": "box2",
              "fill": "#EFF6FF",
              "cornerRadius": 6,
