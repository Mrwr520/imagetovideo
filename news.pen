              "name": "c3at",
              "fill": "#4CAF50",
              "content": "🏛️ 唐代（公元732年）",
              "fontFamily": "Inter",
              "fontSize": 44,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "iIUQ4",
              "name": "c3ad",
              "fill": "#333333",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "唐玄宗下诏将清明扫墓编入礼典，正式成为国家认定的祭祀节日。寒食与清明合二为一。",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
              "fontSize": 46,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "E9Tqv",
          "name": "card3b",
          "width": "fill_container",
