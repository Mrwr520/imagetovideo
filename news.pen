                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "UKTdF",
                  "name": "box2b",
                  "fill": "#334155",
                  "textGrowth": "fixed-width",
                  "width": 908,
                  "content": "若霍尔木兹海峡1-3周内未重开，分析师预计布伦特将冲击$110+。能源股（XOM/CVX）短期受益，但高油价将推高通胀、压制消费和科技股。航空、物流、化工板块承压最大。黄金作为避险资产已突破$5400。",
                  "lineHeight": 1.4,
                  "fontFamily": "Inter",
                  "fontSize": 24,
                  "fontWeight": "normal"
